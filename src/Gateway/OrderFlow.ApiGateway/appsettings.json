{
  "ReverseProxy": {
    "Routes": {
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "docs-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/docs/{**catch-all}"
        }
      },
      "swagger-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/swagger/{**catch-all}"
        }
      },
      "root-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/"
        }
      }
    },
    "Clusters": {
      "orders-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://orderservice:8080/"
          }
        }
      }
    }
  }
}
